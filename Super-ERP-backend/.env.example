# Port where the Express server will listen (defaults to 5000)
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI (Required)
MONGODB_URI=mongodb://localhost:27017/super-erp

# JWT Authentication Secret Key (Required)
JWT_SECRET=your_jwt_signing_secret_key_change_in_prod

# JWT Expiration Duration (optional, defaults to '30d')
JWT_EXPIRE=30d

# Cryptographic Secret Key for sensitive DB fields encryption (Required)
ENCRYPTION_SECRET=your-very-long-random-secret

# Meta Webhook Verification Token (optional, required for Meta API Webhooks integration)
# META_VERIFY_TOKEN=your_meta_webhook_verify_token

# Client Frontend Application URL (optional, used for redirect fallbacks)
CLIENT_URL=http://localhost:5173

# CORS Whitelisted Origins (optional, comma-separated domains. Mirror headers if omitted in dev)
# CORS_ALLOWED_ORIGINS=https://erp.company.com,https://pay.company.com

# Enable Background Cron Tasks (optional, set to 'false' in HPA scaled web pods, defaults to 'true')
ENABLE_CRON_JOBS=true
